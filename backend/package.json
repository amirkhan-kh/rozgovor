{
  "name": "salesai-backend",
  "version": "1.0.0",
  "description": "SalesAI Backend - AI-powered sales call analysis platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "custdev:setup": "node scripts/setup-custdev-db.js",
    "custdev:copy": "node scripts/copy-custdev-data.js",
    "custdev:refresh": "node scripts/copy-custdev-data.js && node scripts/run-custdev-batch.js",
    "custdev:batch": "node scripts/run-custdev-batch.js",
    "custdev:export-transcripts": "node scripts/export-custdev-transcripts.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1027.0",
    "@google-cloud/aiplatform": "^6.5.0",
    "@google-cloud/speech": "^7.3.0",
    "@google-cloud/storage": "^7.19.0",
    "@google-cloud/text-to-speech": "^6.4.0",
    "@google-cloud/vertexai": "^1.11.0",
    "@google/genai": "^1.48.0",
    "@google/generative-ai": "^0.24.1",
    "@pdf-lib/fontkit": "^1.1.1",
    "@prisma/client": "^5.7.0",
    "@types/adm-zip": "^0.5.8",
    "@types/ws": "^8.18.1",
    "@yandex-cloud/nodejs-sdk": "^2.8.0",
    "adm-zip": "^0.5.17",
    "aws-sdk": "^2.1693.0",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "docx": "^9.6.1",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "groq-sdk": "^1.1.2",
    "jsonrepair": "^3.13.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "node-telegram-bot-api": "^0.64.0",
    "openai": "^4.20.0",
    "pdf-lib": "^1.17.1",
    "prisma": "^5.7.0",
    "uuid": "^9.0.0",
    "ws": "^8.20.0",
    "youtube-transcript": "^1.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.19.39",
    "@types/node-cron": "^3.0.11",
    "@types/node-telegram-bot-api": "^0.64.1",
    "@types/uuid": "^9.0.7",
    "jsdom": "^29.0.2",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "vitest": "^4.1.4"
  }
}
